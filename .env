# Konfigurasi URL Backend API
# VUE_APP_API_URL=http://localhost/kasir_inventori_pos_backend/api
VUE_APP_API_URL=https://api.kasir.indorobotika.com/api
# VUE_APP_API_URL=http://127.0.0.1:8000/api

# Opsional: Nama Aplikasi & Timeout Request (ms)
VUE_APP_NAME=Kasir Indorobotika
VUE_APP_TIMEOUT=30000


# (Jika nanti deploy ke server produksi, Anda cukup membuat file .env.production dengan isi VUE_APP_API_URL=[https://api.domain-anda.com/api](https://api.domain-anda.com/api)